        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor Admin as Admin\n    participant UI as Menu Fasilitas\n    participant Sys as Sistem\n    participant DB as Database\n\n    Admin-&gt;&gt;UI: Membuka menu data fasilitas\n    UI-&gt;&gt;Sys: Request daftar fasilitas\n    Sys-&gt;&gt;DB: Ambil data fasilitas\n    DB--&gt;&gt;Sys: Return data\n    Sys--&gt;&gt;UI: Kirim data fasilitas\n    UI--&gt;&gt;Admin: Menampilkan daftar fasilitas\n    \n    Admin-&gt;&gt;UI: Memilih tindakan (Tambah/Ubah/Hapus) &amp; Simpan\n    UI-&gt;&gt;Sys: Kirim perubahan data\n    \n    alt Perubahan Berhasil (Normal Course)\n        Sys-&gt;&gt;DB: Menyimpan perubahan data\n        DB--&gt;&gt;Sys: Data tersimpan\n        Sys--&gt;&gt;UI: Response sukses\n    else Data Tidak Lengkap (Alternate A.1)\n        Sys--&gt;&gt;UI: Validasi gagal\n        UI--&gt;&gt;Admin: Menampilkan pesan kesalahan data tidak lengkap\n    else Data Tidak Ditemukan (Alternate A.2)\n        Sys-&gt;&gt;DB: Cari data\n        DB--&gt;&gt;Sys: Data null\n        Sys--&gt;&gt;UI: Error not found\n        UI--&gt;&gt;Admin: Menampilkan pesan kesalahan data tidak ditemukan\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="3sH5COanQOc2gQkWmccN-1">

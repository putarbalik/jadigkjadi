        <mxCell id="hKaJfjRWVbSQ_0Tql9Kv-1" parent="AwvQSIMCdK5xuYToa7uj-2" style="swimlane;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;Melihat Daftar Fasilitas&lt;/font&gt;" vertex="1">
          <mxGeometry height="751" width="1450" as="geometry" />
        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor User as User (Mahasiswa/Dosen)\n    participant View as Halaman Daftar Fasilitas\n    participant Controller as Pengontrol Fasilitas\n    participant Model as Entitas Fasilitas\n    participant DB as Basis Data\n\n    User-&gt;&gt;View: Membuka halaman daftar fasilitas\n    activate View\n    View-&gt;&gt;Controller: Meminta data daftar fasilitas\n    activate Controller\n    Controller-&gt;&gt;Model: Mengambil seluruh data fasilitas\n    activate Model\n    Model-&gt;&gt;DB: Mengirim kueri pengambilan data fasilitas\n    activate DB\n    DB--&gt;&gt;Model: Mengembalikan data fasilitas\n    deactivate DB\n    Model--&gt;&gt;Controller: Mengirim sekumpulan data fasilitas\n    deactivate Model\n\n    alt Data Fasilitas Tersedia\n        Controller--&gt;&gt;View: Mengirim data daftar fasilitas untuk ditampilkan\n        View--&gt;&gt;User: Menampilkan daftar fasilitas\n    else Data Fasilitas Tidak Tersedia (Kosong)\n        Controller--&gt;&gt;View: Mengirim pesan bahwa fasilitas belum tersedia\n        View--&gt;&gt;User: Menampilkan informasi bahwa belum ada fasilitas yang tersedia\n    end\n\n    deactivate Controller\n    deactivate View&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="jIKugoaS_6yPlaaXAwif-1">
          <mxCell connectable="0" parent="AwvQSIMCdK5xuYToa7uj-2" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>

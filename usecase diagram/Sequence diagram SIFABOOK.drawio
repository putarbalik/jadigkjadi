  <diagram id="rKmg4v7-EAHVXz62_9YC" name="SD_Melihat Detail Fasilitas">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor User as User (Mahasiswa/Dosen)\n    boundary HalamanDaftar as :HalamanDaftarFasilitas\n    boundary HalamanDetail as :HalamanDetailFasilitas\n    control KontrolFasilitas as :FasilitasController\n    entity Database as :Database\n\n    User-&gt;&gt;HalamanDaftar: Pilih salah satu fasilitas dari daftar\n    activate HalamanDaftar\n    HalamanDaftar-&gt;&gt;KontrolFasilitas: requestDetailFasilitas(idFasilitas)\n    activate KontrolFasilitas\n    \n    KontrolFasilitas-&gt;&gt;Database: ambilDetailFasilitas(idFasilitas)\n    activate Database\n    \n    alt Data Fasilitas Ditemukan (Normal Course)\n        Database--&gt;&gt;KontrolFasilitas: return(detailFasilitas)\n        KontrolFasilitas--&gt;&gt;HalamanDetail: tampilkanDetail(detailFasilitas)\n        deactivate HalamanDaftar\n        activate HalamanDetail\n        HalamanDetail--&gt;&gt;User: Tampilkan info (nama, kondisi, status, dll)\n    else Data Fasilitas Tidak Ditemukan (Alternate Course A.1)\n        Database--&gt;&gt;KontrolFasilitas: return(null)\n        deactivate Database\n        KontrolFasilitas--&gt;&gt;HalamanDaftar: tampilkanPesanError(\&quot;Fasilitas tidak tersedia\&quot;)\n        deactivate KontrolFasilitas\n        HalamanDaftar--&gt;&gt;User: Tampilkan pesan kesalahan di layar\n    end\n\n    opt User Melanjutkan ke Peminjaman\n        User-&gt;&gt;HalamanDetail: Klik tombol pinjam/booking\n        HalamanDetail--&gt;&gt;User: Arahkan ke Form Peminjaman\n    end\n    deactivate HalamanDetail\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="y5DFPCpkjcZV2VoUWZe0-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="WgiO2Uyhg02RuRblmdle-2" parent="y5DFPCpkjcZV2VoUWZe0-1" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;sequenceEdgeStyle&quot;,&quot;libavoidRouting&quot;:0,&quot;curved&quot;:0,&quot;rounded&quot;:0};" value="" vertex="1">

        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor Admin as Admin\n    participant UI as Form Update\n    participant Sys as Sistem\n    participant DB as Database\n\n    Admin-&gt;&gt;UI: Memilih fasilitas\n    UI-&gt;&gt;Sys: Request data fasilitas\n    Sys-&gt;&gt;DB: Ambil data\n    DB--&gt;&gt;Sys: Return data\n    Sys--&gt;&gt;UI: Tampilkan data fasilitas\n    UI--&gt;&gt;Admin: Menampilkan data fasilitas\n    \n    Admin-&gt;&gt;UI: Mengubah data &amp; Menyimpan perubahan\n    UI-&gt;&gt;Sys: Kirim data update\n    Sys-&gt;&gt;Sys: Melakukan validasi\n    \n    alt Data Valid &amp; Ditemukan (Normal Course)\n        Sys-&gt;&gt;DB: Memperbarui data fasilitas\n        DB--&gt;&gt;Sys: Data terupdate\n        Sys--&gt;&gt;UI: Response sukses\n    else Fasilitas Tidak Ditemukan (Alternate A.1)\n        Sys--&gt;&gt;UI: Error not found\n        UI--&gt;&gt;Admin: Menampilkan pesan kesalahan\n    else Data Tidak Valid (Alternate A.2)\n        Sys--&gt;&gt;UI: Validasi gagal\n        UI--&gt;&gt;Admin: Meminta admin memperbaiki data\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TT5HfybO9vlpCWfThKdT-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">

  <diagram id="RuJYoexcsayg0zDiaXRd" name="SD_Detail Pengajuan Peminjaman">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Admin as Admin\n    boundary MenuPengajuan as :Menu Pengajuan Peminjaman\n    boundary HalamanDetail as :Halaman Detail Pengajuan\n    control KontrolSistem as :Sistem Pengontrol\n    entity Database as :Basis Data\n\n    Admin-&gt;&gt;MenuPengajuan: Membuka menu pengajuan peminjaman\n    activate MenuPengajuan\n    MenuPengajuan-&gt;&gt;KontrolSistem: Meminta data daftar pengajuan peminjaman\n    activate KontrolSistem\n    \n    KontrolSistem-&gt;&gt;Database: Mengambil seluruh data pengajuan peminjaman\n    activate Database\n    \n    alt Belum Ada Data Pengajuan (Alternate Course A.1)\n        Database--&gt;&gt;KontrolSistem: Mengembalikan data kosong (null)\n        KontrolSistem--&gt;&gt;MenuPengajuan: Mengirimkan instruksi tampilan pesan kosong\n        MenuPengajuan--&gt;&gt;Admin: Menampilkan informasi \&quot;Belum terdapat pengajuan peminjaman\&quot;\n        \n    else Data Pengajuan Tersedia (Normal Course)\n        Database--&gt;&gt;KontrolSistem: Mengirimkan daftar data pengajuan peminjaman\n        KontrolSistem--&gt;&gt;MenuPengajuan: Mengirimkan data untuk ditampilkan ke layar\n        MenuPengajuan--&gt;&gt;Admin: Menyajikan daftar pengajuan peminjaman di layar\n        \n        opt Admin Ingin Melihat Rincian Pengajuan\n            Admin-&gt;&gt;MenuPengajuan: Memilih salah satu pengajuan untuk melihat detailnya\n            MenuPengajuan-&gt;&gt;KontrolSistem: Meminta data detail pengajuan yang dipilih\n            KontrolSistem-&gt;&gt;Database: Mengambil data detail pengajuan berdasarkan ID\n            Database--&gt;&gt;KontrolSistem: Mengirimkan data detail pengajuan lengkap\n            deactivate Database\n            KontrolSistem--&gt;&gt;HalamanDetail: Mengirimkan data detail untuk dimuat di layar\n            deactivate KontrolSistem\n            deactivate MenuPengajuan\n            activate HalamanDetail\n            HalamanDetail--&gt;&gt;Admin: Menampilkan informasi detail permohonan peminjaman\n            deactivate HalamanDetail\n        end\n    end\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="d2htACZvth-r1DZXkd-M-1">

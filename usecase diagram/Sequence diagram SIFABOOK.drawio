        <mxCell id="1" parent="0" />
        <mxCell id="CUIOLEw45lU-yaKe0HE3-51" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;Menghapus Fasilitas&lt;/font&gt;" vertex="1">
          <mxGeometry height="1290" width="1730" x="70" y="70" as="geometry" />
        </mxCell>
        <mxCell id="F6rJSDr4csMamIeZMU0a-2" parent="CUIOLEw45lU-yaKe0HE3-51" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" value="Admin" vertex="1">
          <mxGeometry height="100" width="63.75" x="88.13" y="40" as="geometry" />
        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Admin as Admin\n    boundary MenuFasilitas as :Menu Data Fasilitas\n    control KontrolSistem as :Sistem Pengontrol\n    entity Database as :Basis Data\n\n    Admin-&gt;&gt;MenuFasilitas: Memilih fasilitas yang akan dihapus\n    activate MenuFasilitas\n    MenuFasilitas-&gt;&gt;KontrolSistem: Meminta konfirmasi data fasilitas yang dipilih\n    activate KontrolSistem\n    \n    KontrolSistem-&gt;&gt;Database: Memeriksa ketersediaan dan status transaksi fasilitas\n    activate Database\n    Database--&gt;&gt;KontrolSistem: Mengirimkan data status fasilitas\n    \n    KontrolSistem--&gt;&gt;MenuFasilitas: Menampilkan informasi fasilitas &amp; jendela konfirmasi hapus\n    deactivate KontrolSistem\n    \n    Admin-&gt;&gt;MenuFasilitas: Mengonfirmasi tindakan penghapusan data\n    \n    alt Admin Membatalkan Penghapusan (Alternate Course A.1)\n        Admin-&gt;&gt;MenuFasilitas: Memilih opsi \&quot;Batal\&quot;\n        MenuFasilitas--&gt;&gt;Admin: Menutup jendela konfirmasi &amp; data tidak dihapus\n    \n    else Fasilitas Memiliki Transaksi Aktif (Alternate Course A.2)\n        MenuFasilitas-&gt;&gt;KontrolSistem: Meneruskan permintaan hapus data\n        activate KontrolSistem\n        KontrolSistem-&gt;&gt;KontrolSistem: Memvalidasi keterikatan data transaksi\n        KontrolSistem--&gt;&gt;MenuFasilitas: Menginfokan bahwa data terikat transaksi aktif\n        MenuFasilitas--&gt;&gt;Admin: Menampilkan pesan kesalahan \&quot;Penghapusan ditolak karena transaksi aktif\&quot;\n        \n    else Proses Hapus Berhasil (Normal Course)\n        MenuFasilitas-&gt;&gt;KontrolSistem: Meneruskan permintaan hapus data\n        KontrolSistem-&gt;&gt;Database: Menghapus data fasilitas dari sistem\n        Database--&gt;&gt;KontrolSistem: Mengonfirmasi data berhasil dihapus\n        deactivate Database\n        KontrolSistem--&gt;&gt;MenuFasilitas: Mengirimkan status penghapusan sukses\n        deactivate KontrolSistem\n        MenuFasilitas--&gt;&gt;Admin: Menampilkan notifikasi \&quot;Data fasilitas berhasil dihapus\&quot;\n    end\n    \n    deactivate MenuFasilitas\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CUIOLEw45lU-yaKe0HE3-102">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>

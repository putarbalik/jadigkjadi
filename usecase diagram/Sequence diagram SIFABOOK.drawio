        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Admin as Admin\n    boundary HalamanDetail as :Halaman Detail Pengajuan\n    boundary DialogTolak as :Jendela Alasan Penolakan\n    control KontrolSistem as :Sistem Pengontrol\n    entity Database as :Basis Data\n\n    Admin-&gt;&gt;HalamanDetail: Membuka dan memeriksa detail data pengajuan\n    activate HalamanDetail\n    Admin-&gt;&gt;HalamanDetail: Menekan opsi \&quot;Tolak\&quot;\n    \n    HalamanDetail-&gt;&gt;DialogTolak: Menampilkan jendela input alasan penolakan\n    activate DialogTolak\n    \n    alt Admin Membatalkan Proses Penolakan (Alternate Course A.1)\n        Admin-&gt;&gt;DialogTolak: Menekan tombol \&quot;Batal\&quot;\n        DialogTolak--&gt;&gt;HalamanDetail: Menutup jendela input &amp; status pengajuan tetap (tidak berubah)\n        HalamanDetail--&gt;&gt;Admin: Kembali ke tampilan detail pengajuan semula\n        \n    else Admin Melanjutkan Penolakan (Normal Course)\n        Admin-&gt;&gt;DialogTolak: Memasukkan alasan penolakan &amp; menekan tombol \&quot;Konfirmasi Tolak\&quot;\n        \n        DialogTolak-&gt;&gt;KontrolSistem: Mengirimkan permintaan penolakan beserta alasan\n        activate KontrolSistem\n        \n        KontrolSistem-&gt;&gt;Database: Mengubah status pengajuan menjadi \&quot;Ditolak\&quot; &amp; menyimpan alasan\n        activate Database\n        Database--&gt;&gt;KontrolSistem: Mengonfirmasi perubahan status berhasil disimpan\n        deactivate Database\n        \n        KontrolSistem--&gt;&gt;DialogTolak: Mengirimkan status penolakan sukses\n        deactivate KontrolSistem\n        \n        DialogTolak--&gt;&gt;HalamanDetail: Menutup jendela input alasan\n        deactivate DialogTolak\n        HalamanDetail--&gt;&gt;Admin: Menampilkan notifikasi \&quot;Status pengajuan berhasil diubah menjadi ditolak\&quot;\n    end\n    \n    deactivate HalamanDetail\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="jUJOneUUByeTSrUDZ18_-1">

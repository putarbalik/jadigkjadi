        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Admin as Admin\n    boundary MenuKembali as :Menu Pengembalian Fasilitas\n    boundary HalamanCatat as :Halaman Pencatatan Pengembalian\n    control KontrolSistem as :Sistem Pengontrol\n    entity Database as :Basis Data\n\n    Admin-&gt;&gt;MenuKembali: Membuka data peminjaman aktif\n    activate MenuKembali\n    Admin-&gt;&gt;MenuKembali: Memilih transaksi yang akan dikembalikan\n    \n    MenuKembali-&gt;&gt;HalamanCatat: Menampilkan formulir pengembalian fasilitas\n    deactivate MenuKembali\n    activate HalamanCatat\n    \n    Admin-&gt;&gt;HalamanCatat: Memeriksa kondisi fisik fasilitas &amp; memasukkan data pengembalian\n    \n    alt Fasilitas Belum Dikembalikan Fisiknya (Alternate Course A.1)\n        Admin-&gt;&gt;HalamanCatat: Memilih opsi simpan sebagai \&quot;Belum Kembali\&quot;\n        HalamanCatat--&gt;&gt;Admin: Status peminjaman tetap sebagai \&quot;Sedang Dipinjam\&quot;\n        \n    else Terdapat Masalah Kondisi Fisik / Rusak (Alternate Course A.2)\n        Admin-&gt;&gt;HalamanCatat: Mencatat catatan kondisi masalah/kerusakan pada formulir\n        HalamanCatat-&gt;&gt;KontrolSistem: Mengirim data pengembalian dengan catatan kondisi\n        activate KontrolSistem\n        \n        KontrolSistem-&gt;&gt;Database: Menyimpan data pengembalian &amp; catatan kondisi kerusakan\n        activate Database\n        Database--&gt;&gt;KontrolSistem: Mengonfirmasi data berhasil disimpan\n        \n        KontrolSistem-&gt;&gt;Database: Memperbarui status fasilitas (misal: \&quot;Perbaikan/Rusak\&quot;)\n        Database--&gt;&gt;KontrolSistem: Mengonfirmasi status fasilitas diperbarui\n        \n        KontrolSistem--&gt;&gt;HalamanCatat: Mengirimkan status pencatatan sukses\n        deactivate KontrolSistem\n        HalamanCatat--&gt;&gt;Admin: Menampilkan notifikasi \&quot;Pengembalian dan catatan kondisi berhasil disimpan\&quot;\n        \n    else Proses Pengembalian Normal Berhasil (Normal Course)\n        Admin-&gt;&gt;HalamanCatat: Menekan tombol \&quot;Catat Pengembalian\&quot;\n        HalamanCatat-&gt;&gt;KontrolSistem: Meneruskan permintaan pencatatan pengembalian\n        activate KontrolSistem\n        \n        KontrolSistem-&gt;&gt;Database: Mengubah status peminjaman menjadi \&quot;Dikembalikan\&quot;\n        activate Database\n        Database--&gt;&gt;KontrolSistem: Mengonfirmasi perubahan status transaksi\n        \n        KontrolSistem-&gt;&gt;Database: Memperbarui status fasilitas menjadi \&quot;Tersedia\&quot;\n        Database--&gt;&gt;KontrolSistem: Mengonfirmasi status fasilitas diperbarui\n        deactivate Database\n        \n        KontrolSistem--&gt;&gt;HalamanCatat: Mengirimkan status pengembalian sukses\n        deactivate KontrolSistem\n        HalamanCatat--&gt;&gt;Admin: Menampilkan notifikasi \&quot;Data disimpan dan fasilitas tersedia kembali\&quot;\n    end\n    \n    deactivate HalamanCatat\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="NikByPI5cjkMEv1YTVGj-63">
          <mxCell connectable="0" parent="NikByPI5cjkMEv1YTVGj-124" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">

  <diagram id="LJz4ZJ76lOPgYTIV1_n4" name="SD_Menyetujui Peminjaman">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Admin as Admin\n    boundary HalamanDetail as :Halaman Detail Pengajuan\n    control KontrolSistem as :Sistem Pengontrol\n    entity Database as :Basis Data\n\n    Admin-&gt;&gt;HalamanDetail: Membuka dan memeriksa detail data pengajuan\n    activate HalamanDetail\n    Admin-&gt;&gt;HalamanDetail: Menekan tombol \&quot;Setujui\&quot;\n    \n    HalamanDetail-&gt;&gt;KontrolSistem: Mengirimkan permintaan persetujuan pengajuan\n    activate KontrolSistem\n    \n    KontrolSistem-&gt;&gt;Database: Memeriksa kembali ketersediaan fasilitas pada jadwal tersebut\n    activate Database\n    Database--&gt;&gt;KontrolSistem: Mengembalikan status ketersediaan terkini\n    \n    alt Fasilitas Tidak Tersedia / Bentrok (Alternate Course A.2)\n        KontrolSistem--&gt;&gt;HalamanDetail: Menginfokan pengajuan tidak dapat disetujui karena jadwal bentrok\n        HalamanDetail--&gt;&gt;Admin: Menampilkan pesan kesalahan \&quot;Persetujuan gagal, fasilitas tidak tersedia\&quot;\n        \n    else Data Pengajuan Tidak Sesuai (Alternate Course A.1)\n        KontrolSistem--&gt;&gt;HalamanDetail: Menginfokan ketidaksesuaian data persyaratan\n        HalamanDetail--&gt;&gt;Admin: Menampilkan opsi untuk menolak pengajuan secara manual\n        \n    else Proses Persetujuan Berhasil (Normal Course)\n        KontrolSistem-&gt;&gt;Database: Mengubah status pengajuan menjadi \&quot;Disetujui\&quot;\n        Database--&gt;&gt;KontrolSistem: Mengonfirmasi perubahan status berhasil disimpan\n        deactivate Database\n        \n        KontrolSistem--&gt;&gt;HalamanDetail: Mengirimkan status persetujuan sukses\n        deactivate KontrolSistem\n        HalamanDetail--&gt;&gt;Admin: Menampilkan notifikasi \&quot;Pengajuan peminjaman berhasil disetujui\&quot;\n    end\n    \n    deactivate HalamanDetail\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9jw69xa5ZH5ZTu35Y2TK-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="alt" mermaidId="n:f0" mermaidBaseStyle="html=1;shape=umlFrame;dashed=1;fixDash=1;dashPattern=2 2;strokeWidth=2;pointerEvents=0;dropTarget=0;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontSize=16;align=center;verticalAlign=middle;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);height=20;width=50;" mermaidBaseValue="alt" id="9jw69xa5ZH5ZTu35Y2TK-9">
